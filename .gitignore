# ==============================================================================
# Science Universe — Comprehensive Git Ignore (.gitignore)
# Configured for Private Repository & Reproducible Android/Web CI Builds
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 2. Build Outputs & Generated Web Assets
# (Generated by `node tools/sync_web.mjs` and Capacitor sync)
# ------------------------------------------------------------------------------
www/
dist/
build/
.netlify/

# ------------------------------------------------------------------------------
# 3. Android Build Artifacts, Intermediates & Local SDK Config
# ------------------------------------------------------------------------------
# Local machine configurations
android/local.properties
android/.gradle/
.gradle/

# Android build outputs & intermediate caches
android/app/build/
android/build/
android/captures/
android/.cxx/
android/.externalNativeBuild/

# Copied web assets & generated configs inside Android (recreated by `npx cap sync`)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/

# Standalone and compiled binaries
*.apk
*.aab
*.aar
*.dex
*.class

# Local portable JDK bundled in workspace
tools/jdk-21/

# ------------------------------------------------------------------------------
# 4. iOS Build Artifacts & Generated Assets
# ------------------------------------------------------------------------------
ios/App/App/public/
ios/App/Pods/
ios/App/Podfile.lock
*.xcworkspace
*.xcuserdata
*.xcuserdatad
DerivedData/

# ------------------------------------------------------------------------------
# 5. Checkpoints, Tarballs, Backups & Incomplete Large Downloads
# ------------------------------------------------------------------------------
checkpoints/
_original_backup/
*.tar
*.tar.gz
*.zip
*.bak*
*.backup*
*.partial
*.part
*.crdownload

# Incomplete large satellite/planetary terrain datasets
*.tif.partial
*.img.partial
SCIENCE_UNIVERSE_PROJECT_BACKUP/public/assets/terrain/moon/lola_118m/*.partial
SCIENCE_UNIVERSE_PROJECT_BACKUP/public/assets/terrain/moon/lroc_wac/*.partial

# ------------------------------------------------------------------------------
# 6. Diagnostic Files, Test Artifacts, Screenshots & Logs
# ------------------------------------------------------------------------------
scratch/
tests/integration_shots/
tests/responsive_shots/
*.log
*.hprof

# Root diagnostic dumps and run screenshots
android-webgl-*.png
android-webgl-*.json
android-webgl-*.txt
android-webgl-*.log
android-native-promise-trace.*
desktop-build-webgl-diagnostic.*
developer-access-*.log
developer-access-*.png
developer-ui-*.png
developer-ui-*.log

# ------------------------------------------------------------------------------
# 7. Secrets, Keystores, Certificates & Environment Variables
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.secret
google-services.json

# ------------------------------------------------------------------------------
# 8. IDE, Editor & Operating System Caches
# ------------------------------------------------------------------------------
.idea/
.vscode/
.kilo/
*.iml
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
